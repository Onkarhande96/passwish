# ==============================================================
# PassWish Cloud & Web Configuration
# ==============================================================

# 1. Free Lifetime Cloud Database (Neon.tech or Supabase)
# Sign up at https://neon.tech (Free Forever, 500 MB - stores 50,000+ customers)
# Paste your connection string below to run with 100% cloud persistent data:
# DATABASE_URL=postgresql://username:password@ep-something.neon.tech/neondb?sslmode=require

# 2. Secret Key for Secure User Sessions
SECRET_KEY=passwish-crm-ultra-secure-key-2026

# 3. Web Mode (Bypasses desktop licensing lock for multi-user web access)
WEB_MODE=true
